#################################################################
# Object properties: work, ownership, and evidence
#################################################################

refine:ownedByNode
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( refine:Feature refine:Goal )
    ] ;
    rdfs:range refine:Node ;
    rdfs:label "owned by Node"@en .

refine:groupsGoal
    a owl:ObjectProperty ;
    owl:inverseOf refine:memberOfFeature ;
    rdfs:domain refine:Feature ;
    rdfs:range refine:Goal ;
    rdfs:label "groups Goal"@en ;
    refine:implementedAs "Derived inverse of Goal.feature_id; not embedded in feature.json." .

refine:memberOfFeature
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain refine:Goal ;
    rdfs:range refine:Feature ;
    rdfs:label "member of Feature"@en .

refine:hasNote
    a owl:ObjectProperty ;
    owl:inverseOf refine:noteOfGoal ;
    rdfs:domain refine:Goal ;
    rdfs:range refine:GoalNote ;
    rdfs:label "has Note"@en .

refine:noteOfGoal
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain refine:GoalNote ;
    rdfs:range refine:Goal ;
    rdfs:label "Note of Goal"@en .

refine:hasRound
    a owl:ObjectProperty ;
    owl:inverseOf refine:roundOfGoal ;
    rdfs:domain refine:Goal ;
    rdfs:range refine:GoalRound ;
    rdfs:label "has Round"@en .

refine:roundOfGoal
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain refine:GoalRound ;
    rdfs:range refine:Goal ;
    rdfs:label "Round of Goal"@en .

refine:hasStatus
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain refine:Goal ;
    rdfs:range refine:GoalStatus ;
    rdfs:label "has status"@en .

refine:hasPriority
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain refine:Goal ;
    rdfs:range refine:GoalPriority ;
    rdfs:label "has priority"@en .

refine:hasQualityTiming
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain refine:GoalRound ;
    rdfs:range refine:QualityTiming ;
    rdfs:label "has pinned Quality timing"@en .

refine:hasRoundEvidence
    a owl:ObjectProperty ;
    rdfs:domain refine:GoalRound ;
    rdfs:range refine:RoundEvidence ;
    rdfs:label "has Round evidence"@en .

refine:hasIntegrationEvidence
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:subPropertyOf refine:hasRoundEvidence ;
    rdfs:domain refine:GoalRound ;
    rdfs:range refine:RoundIntegration ;
    rdfs:label "has integration evidence"@en .

refine:hasRoundLogEntry
    a owl:ObjectProperty ;
    rdfs:subPropertyOf refine:hasRoundEvidence ;
    rdfs:domain refine:GoalRound ;
    rdfs:range refine:RoundLogEntry ;
    rdfs:label "has Round log entry"@en .

refine:hasTodoItem
    a owl:ObjectProperty ;
    owl:inverseOf refine:itemOfTodoList ;
    rdfs:domain refine:TodoList ;
    rdfs:range refine:TodoItem ;
    rdfs:label "has Todo item"@en .

refine:itemOfTodoList
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain refine:TodoItem ;
    rdfs:range refine:TodoList ;
    rdfs:label "item of Todo list"@en .

