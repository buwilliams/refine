refine:priorityLow
    a owl:NamedIndividual , refine:GoalPriority ;
    rdfs:label "Low"@en ;
    refine:wireToken "low" .

refine:priorityMedium
    a owl:NamedIndividual , refine:GoalPriority ;
    rdfs:label "Medium"@en ;
    refine:wireToken "medium" .

refine:priorityHigh
    a owl:NamedIndividual , refine:GoalPriority ;
    rdfs:label "High"@en ;
    refine:wireToken "high" .

