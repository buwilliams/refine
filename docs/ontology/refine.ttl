    rdfs:domain refine:DerivedEntity ;
    rdfs:range refine:DomainEntity ;
    rdfs:label "derived from"@en .

#################################################################
# Datatype properties
#################################################################

refine:identifier
    a owl:DatatypeProperty ;
    rdfs:domain refine:DomainEntity ;
    rdfs:range xsd:string ;
    rdfs:label "identifier"@en .

refine:name
    a owl:DatatypeProperty ;
    rdfs:domain refine:DomainEntity ;
    rdfs:range xsd:string ;
    rdfs:label "name"@en .

refine:reporterName
    a owl:DatatypeProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( refine:Feature refine:Goal refine:GoalRound refine:TodoList )
    ] ;
    rdfs:range xsd:string ;
    rdfs:label "Reporter name"@en ;
    rdfs:comment
        "A denormalized name reference. It is not an RDF object link to a Reporter registry ID."@en .

refine:assigneeName
    a owl:DatatypeProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( refine:Feature refine:Goal refine:GoalRound )
    ] ;
    rdfs:range xsd:string ;
    rdfs:label "Assignee name"@en ;
    rdfs:comment
        "A denormalized actor name; current Goal assignment is derived primarily from the latest Round."@en .

refine:featureOrder
    a owl:DatatypeProperty ;
    rdfs:domain refine:Goal ;
    rdfs:range xsd:integer ;
    rdfs:label "Feature order"@en ;
    rdfs:comment "Absence means unordered; a value means ordered placement."@en .

refine:roundIndex
    a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain refine:GoalRound ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "Round index"@en ;
    rdfs:comment "Zero-based array index and workflow identity of the Round."@en .

refine:workflowRevision
    a owl:DatatypeProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( refine:Feature refine:Goal )
    ] ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "workflow revision"@en .

refine:decisionVersion
    a owl:DatatypeProperty ;
    rdfs:domain refine:WorkflowClaim ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "decision version"@en .

refine:branchName
    a owl:DatatypeProperty ;
    rdfs:domain refine:Goal ;
    rdfs:range xsd:string ;
    rdfs:label "branch name"@en .

refine:targetBranch
    a owl:DatatypeProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( refine:Goal refine:RoundIntegration )
    ] ;
    rdfs:range xsd:string ;
    rdfs:label "target branch"@en .

refine:baseCommit
    a owl:DatatypeProperty ;
    rdfs:domain refine:Goal ;
    rdfs:range xsd:string ;
    rdfs:label "base commit"@en .

refine:candidateCommit
    a owl:DatatypeProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( refine:Goal refine:RoundIntegration )
    ] ;
    rdfs:range xsd:string ;
    rdfs:label "candidate commit"@en .

refine:targetCommit
    a owl:DatatypeProperty ;
    rdfs:domain refine:RoundIntegration ;
    rdfs:range xsd:string ;
    rdfs:label "target commit"@en .

refine:createdAt
    a owl:DatatypeProperty ;
    rdfs:domain refine:DomainEntity ;
    rdfs:range xsd:dateTime ;
    rdfs:label "created at"@en .

refine:updatedAt
    a owl:DatatypeProperty ;
    rdfs:domain refine:DomainEntity ;
    rdfs:range xsd:dateTime ;
    rdfs:label "updated at"@en .

#################################################################
# Status and value properties
#################################################################

refine:manualTransitionTo
    a owl:ObjectProperty ;
    rdfs:domain refine:GoalStatus ;
    rdfs:range refine:GoalStatus ;
    rdfs:label "manual transition to"@en .

refine:automatedTransitionTo
    a owl:ObjectProperty ;
    rdfs:domain refine:GoalStatus ;
    rdfs:range refine:GoalStatus ;
    rdfs:label "automated transition to"@en .

refine:promotionTransitionTo
    a owl:ObjectProperty ;
    rdfs:domain refine:GoalStatus ;
    rdfs:range refine:GoalStatus ;
    rdfs:label "promotion transition to"@en .

refine:approvalTransitionTo
    a owl:ObjectProperty ;
    rdfs:domain refine:GoalStatus ;
    rdfs:range refine:GoalStatus ;
    rdfs:label "approval transition to"@en .

#################################################################
# Goal status vocabulary and transition graph
#################################################################

refine:GoalStatus
    a owl:Class ;
    rdfs:subClassOf refine:VocabularyConcept ;
    owl:oneOf (
        refine:statusBacklog
        refine:statusTodo
        refine:statusInProgress
        refine:statusQa
        refine:statusReadyMerge
        refine:statusBuild
        refine:statusReview
        refine:statusDone
        refine:statusFailed
        refine:statusCancelled
    ) ;
    rdfs:label "Goal Status"@en ;
    refine:codeReference "src/model/workflow/mod.rs#GoalStatus" .

refine:statusBacklog
    a owl:NamedIndividual , refine:GoalStatus ;
    rdfs:label "Backlog"@en ;
    refine:wireToken "backlog" ;
    refine:manualTransitionTo refine:statusTodo ;
    refine:promotionTransitionTo refine:statusTodo .

refine:statusTodo
    a owl:NamedIndividual , refine:GoalStatus ;
    rdfs:label "Todo"@en ;
    refine:wireToken "todo" ;
    refine:manualTransitionTo refine:statusBacklog ;
    refine:automatedTransitionTo refine:statusInProgress .

refine:statusInProgress
    a owl:NamedIndividual , refine:GoalStatus ;
    rdfs:label "In Progress"@en ;
    refine:wireToken "in-progress" ;
    refine:automatedTransitionTo
        refine:statusQa ,
        refine:statusReadyMerge ,
        refine:statusFailed .

refine:statusQa
    a owl:NamedIndividual , refine:GoalStatus ;
    rdfs:label "QA"@en ;
    refine:wireToken "qa" ;
    refine:automatedTransitionTo
        refine:statusReadyMerge ,
        refine:statusReview ,
        refine:statusBuild ,
        refine:statusFailed .

refine:statusReadyMerge
    a owl:NamedIndividual , refine:GoalStatus ;
    rdfs:label "Ready Merge"@en ;
    refine:wireToken "ready-merge" ;
    refine:automatedTransitionTo
        refine:statusBuild ,
        refine:statusQa ,
        refine:statusFailed .

refine:statusBuild
    a owl:NamedIndividual , refine:GoalStatus ;
    rdfs:label "Build"@en ;
    refine:wireToken "build" ;
    refine:automatedTransitionTo
        refine:statusQa ,
        refine:statusReview ,
        refine:statusFailed .

refine:statusReview
    a owl:NamedIndividual , refine:GoalStatus ;
    rdfs:label "Review"@en ;
    refine:wireToken "review" ;
    refine:approvalTransitionTo refine:statusDone .

refine:statusDone
    a owl:NamedIndividual , refine:GoalStatus ;
    rdfs:label "Done"@en ;
    refine:wireToken "done" ;
    refine:manualTransitionTo refine:statusReview .

refine:statusFailed
    a owl:NamedIndividual , refine:GoalStatus ;
    rdfs:label "Failed"@en ;
    refine:wireToken "failed" ;
    refine:manualTransitionTo refine:statusTodo .

refine:statusCancelled
    a owl:NamedIndividual , refine:GoalStatus ;
    rdfs:label "Cancelled"@en ;
    refine:wireToken "cancelled" ;
    refine:manualTransitionTo refine:statusTodo .

#################################################################
# Goal priority vocabulary
#################################################################

refine:GoalPriority
    a owl:Class ;
    rdfs:subClassOf refine:VocabularyConcept ;
    owl:oneOf (
        refine:priorityLow
        refine:priorityMedium
        refine:priorityHigh
    ) ;
