refine:processForGoal
    a owl:ObjectProperty ;
    rdfs:domain refine:ManagedProcess ;
    rdfs:range refine:Goal ;
    rdfs:label "Process for Goal"@en ;
    refine:implementedAs "Correlation in structured process metadata." .

refine:processForClaim
    a owl:ObjectProperty ;
    rdfs:domain refine:ManagedProcess ;
    rdfs:range refine:WorkflowClaim ;
    rdfs:label "Process for Claim"@en ;
    refine:implementedAs "Correlation in structured process metadata." .

refine:processForExecution
    a owl:ObjectProperty ;
    rdfs:domain refine:ManagedProcess ;
    rdfs:range refine:WorkflowExecution ;
    rdfs:label "Process for Execution"@en ;
    refine:implementedAs "Correlation in structured process metadata." .

refine:goalHasWorktree
    a owl:ObjectProperty ;
    rdfs:domain refine:Goal ;
    rdfs:range refine:GitWorktree ;
    rdfs:label "Goal has worktree"@en .

refine:agentSessionBackedByProcess
    a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain refine:AgentSession ;
    rdfs:range refine:ManagedProcess ;
